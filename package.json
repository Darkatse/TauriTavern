{
  "name": "tauritavern",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "tauri": "node scripts/tauri-app.mjs --prepare-frontend",
    "android": "node scripts/tauri-app.mjs --prepare-frontend android",
    "ohos": "node scripts/tauri-app.mjs --prepare-frontend ohos",
    "ios": "node scripts/tauri-app.mjs --prepare-frontend ios",
    "build": "node --run tauri:build",
    "dev": "node --run tauri:dev",
    "check": "node --run check:platform && node --run check:frontend && node --run check:types && node --run check:lint && node --run check:logging-boundaries && node --run check:rust-boundaries && node --run check:rust:fmt && node --run test && node --run check:rust:clippy",
    "check:platform": "node scripts/check-platform-identity.mjs",
    "check:frontend": "node scripts/check-frontend-guardrails.mjs && node scripts/check-first-party-ui-guardrails.mjs",
    "check:frontend:baseline": "node scripts/check-frontend-guardrails.mjs --update-baseline",
    "check:types": "tsc -b tsconfig.host.json tsconfig.ui.json && tsc -p packages/app-use/tsconfig.json --incremental --tsBuildInfoFile .cache/tsconfig.app-use.tsbuildinfo",
    "check:lint": "eslint --cache --cache-strategy content --cache-location .cache/eslint --no-error-on-unmatched-pattern \"src/scripts/extensions/in-app-agent/src/**/*.{ts,tsx}\" \"src/scripts/extensions/agent-system/src/**/*.{ts,tsx}\" \"src/scripts/extensions/mcp-manager/src/**/*.{ts,tsx}\" \"src/scripts/tauri/setting/**/*.{ts,tsx}\" \"packages/app-use/src/**/*.{ts,tsx}\"",
    "check:logging-boundaries": "node scripts/check-logging-boundaries.mjs",
    "check:rust-boundaries": "node scripts/check-rust-crate-boundaries.mjs",
    "check:rust:dev": "cargo check --manifest-path src-tauri/Cargo.toml --workspace --no-default-features",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --no-default-features --features tauritavern/perf -- -D warnings",
    "check:advisories": "node scripts/check-dependency-advisories.mjs",
    "test": "node --run test:perf && node --run test:contracts && node --run test:dom && node --run test:rust",
    "test:perf": "node tests/perf/run.mjs",
    "test:contracts": "node --test --test-timeout=60000 --test-force-exit \"tests/*.test.mjs\"",
    "test:dom": "node --run web:build && rstest && rstest --browser.name webkit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --no-default-features --tests",
    "skills:tt-docs": "node scripts/builtin-skills/build-tt-docs.mjs",
    "web:build": "rspack build --config rspack.config.js --mode production",
    "web:dev": "rspack build --config rspack.config.js --mode development --watch",
    "tauri:dev": "node scripts/tauri-app.mjs --prepare-frontend dev",
    "tauri:dev:pilot": "node scripts/tauri-app.mjs --prepare-frontend dev --features devtools-pilot",
    "tauri:build": "node scripts/tauri-app.mjs --prepare-frontend build",
    "tauri:build:portable": "node scripts/build-portable.mjs",
    "tauri:build:portable:skip-web": "node scripts/build-portable.mjs --skip-web-build",
    "flatpak:build": "bash packaging/flatpak/build.sh",
    "flatpak:sources": "bash packaging/flatpak/generate-sources.sh",
    "flatpak:sources:check": "bash packaging/flatpak/generate-sources.sh --check",
    "android:dev": "node scripts/tauri-app.mjs --prepare-frontend android dev",
    "android:dev:pilot": "node scripts/tauri-app.mjs --prepare-frontend android dev --features devtools-pilot",
    "android:build": "node scripts/tauri-app.mjs --prepare-frontend android build",
    "ios:dev": "node scripts/tauri-app.mjs --prepare-frontend ios dev",
    "ios:dev:pilot": "node scripts/tauri-app.mjs --prepare-frontend ios dev --features devtools-pilot",
    "ios:build": "node scripts/tauri-app.mjs --prepare-frontend ios build",
    "ios:dev:policy": "node scripts/ios-policy.mjs dev",
    "ios:build:policy": "node scripts/ios-policy.mjs build",
    "fastools:build": "cargo build --release --manifest-path fastools/Cargo.toml",
    "fastools:run": "cargo run --manifest-path fastools/Cargo.toml"
  },
  "devDependencies": {
    "@parcel/watcher": "^2.6.0",
    "@rspack/cli": "^2.3.1",
    "@rspack/core": "^2.3.1",
    "@rstest/browser": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jquery": "^3.5.33",
    "@types/jquery-cropper": "^1.0.4",
    "@types/jquery.transit": "^0.9.33",
    "@types/jqueryui": "^1.12.24",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/select2": "^4.0.63",
    "@types/toastr": "^2.1.43",
    "dom-accessibility-api": "^0.7.1",
    "es-module-lexer": "^2.3.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@adobe/css-tools": "^4.4.4",
    "@codemirror/commands": "6.11.0",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@iconfu/svg-inject": "^1.2.3",
    "@mozilla/readability": "^0.6.0",
    "@popperjs/core": "^2.11.8",
    "@tanstack/virtual-core": "3.17.7",
    "@tauritavern/app-use": "workspace:*",
    "bowser": "^2.12.1",
    "chalk": "^5.6.0",
    "chevrotain": "^11.2.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.17",
    "droll": "^0.2.1",
    "fflate": "^0.8.3",
    "fuse.js": "^7.1.0",
    "handlebars": "^4.7.10",
    "highlight.js": "^11.11.1",
    "js-sha256": "^0.11.1",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "morphdom": "^2.7.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "seedrandom": "^3.0.5",
    "showdown": "^2.1.0",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
