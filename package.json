{
  "name": "tauritavern",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "tauri": "node scripts/tauri-app.mjs --prepare-frontend",
    "android": "node scripts/tauri-app.mjs --prepare-frontend android",
    "ios": "node scripts/tauri-app.mjs --prepare-frontend ios",
    "build": "pnpm run tauri:build",
    "dev": "pnpm run tauri:dev",
    "check": "pnpm run check:frontend && pnpm run check:types && pnpm run check:lint && pnpm run check:logging-boundaries && pnpm run check:rust-boundaries && pnpm test && pnpm run check:rust:clippy",
    "check:frontend": "node scripts/check-frontend-guardrails.mjs",
    "check:frontend:baseline": "node scripts/check-frontend-guardrails.mjs --update-baseline",
    "check:types": "tsc -p tsconfig.host.json && tsc -p tsconfig.ui.json",
    "check:lint": "eslint --cache --cache-strategy content --cache-location .cache/eslint \"src/scripts/extensions/**/*.{ts,tsx}\"",
    "check:logging-boundaries": "node scripts/check-logging-boundaries.mjs",
    "check:rust-boundaries": "node scripts/check-rust-crate-boundaries.mjs",
    "check:rust:dev": "cargo check --manifest-path src-tauri/Cargo.toml --workspace --no-default-features",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "test": "pnpm run test:contracts && pnpm run test:ui && pnpm run test:rust",
    "test:contracts": "pnpm run web:build && node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:ui": "rstest --config rstest.config.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --no-default-features",
    "web:build": "rspack build --config rspack.config.js",
    "web:dev": "rspack build --config rspack.config.js --watch",
    "tauri:dev": "node scripts/tauri-app.mjs --prepare-frontend dev",
    "tauri:dev:pilot": "node scripts/tauri-app.mjs --prepare-frontend dev --features devtools-pilot --config src-tauri/crates/tauritavern/tauri.pilot.conf.json",
    "tauri:build": "node scripts/tauri-app.mjs --prepare-frontend build",
    "tauri:build:portable": "node scripts/build-portable.mjs",
    "tauri:build:portable:skip-web": "node scripts/build-portable.mjs --skip-web-build",
    "flatpak:build": "bash packaging/flatpak/build.sh",
    "flatpak:sources": "bash packaging/flatpak/generate-sources.sh",
    "flatpak:sources:check": "bash packaging/flatpak/generate-sources.sh --check",
    "android:dev": "node scripts/tauri-app.mjs --prepare-frontend android dev",
    "android:build": "node scripts/tauri-app.mjs --prepare-frontend android build",
    "ios:dev": "node scripts/tauri-app.mjs --prepare-frontend ios dev",
    "ios:build": "node scripts/tauri-app.mjs --prepare-frontend ios build",
    "ios:dev:policy": "node scripts/ios-policy.mjs dev",
    "ios:build:policy": "node scripts/ios-policy.mjs build",
    "fastools:build": "cargo build --release --manifest-path fastools/Cargo.toml",
    "fastools:run": "cargo run --manifest-path fastools/Cargo.toml"
  },
  "devDependencies": {
    "@rspack/cli": "^2.0.8",
    "@rspack/core": "^2.0.8",
    "@rstest/core": "^0.11.6",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jquery": "^3.5.33",
    "@types/jquery-cropper": "^1.0.4",
    "@types/jquery.transit": "^0.9.33",
    "@types/jqueryui": "^1.12.24",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/select2": "^4.0.63",
    "@types/toastr": "^2.1.43",
    "es-module-lexer": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@adobe/css-tools": "^4.4.4",
    "@iconfu/svg-inject": "^1.2.3",
    "@mozilla/readability": "^0.6.0",
    "@popperjs/core": "^2.11.8",
    "@tanstack/virtual-core": "3.17.7",
    "bowser": "^2.12.1",
    "chalk": "^5.6.0",
    "chevrotain": "^11.2.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.2",
    "droll": "^0.2.1",
    "fflate": "^0.8.2",
    "fuse.js": "^7.1.0",
    "handlebars": "^4.7.9",
    "highlight.js": "^11.11.1",
    "js-sha256": "^0.11.1",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "morphdom": "^2.7.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "seedrandom": "^3.0.5",
    "showdown": "^2.1.0",
    "vue": "^3.5.33",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "lodash-es": "4.18.1"
    }
  }
}
