{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "capabilities": [
        "default",
        "desktop-fullscreen",
        "system-file-picker",
        "mobile-barcode-scanner",
        "android-speech-synthesis",
        {
          "identifier": "pilot-devtools",
          "description": "Development-only capability for tauri-pilot WebView automation.",
          "windows": [
            "main"
          ],
          "permissions": [
            "pilot:default"
          ]
        }
      ]
    }
  }
}
