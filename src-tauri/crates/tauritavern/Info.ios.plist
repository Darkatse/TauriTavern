<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).ai-generation.*</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>TauriTavern uses the camera only to scan LAN Sync pairing QR codes between your devices.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>TauriTavern uses Local Network access only for LAN Sync between your devices on the same Wi‑Fi.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TauriTavern saves images to your photo library only when you choose to save an image.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
</dict>
</plist>
