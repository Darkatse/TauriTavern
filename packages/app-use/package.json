{
  "name": "@tauritavern/app-use",
  "version": "0.1.2",
  "description": "Semantic DOM observation, interaction and agent cursor for SillyTavern pages.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
